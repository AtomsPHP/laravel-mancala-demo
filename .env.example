APP_NAME="Atoms Mancala"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug
SESSION_DRIVER=file

# The session IS the player's seat, so it has to outlive a game. Laravel's
# 120-minute default would quietly reseat anyone who stepped away from a table
# that lives for MANCALA_GAME_LIFETIME_HOURS.
SESSION_LIFETIME=1440

ATOMS_ENVIRONMENT=production
ATOMS_ENDPOINT=http://127.0.0.1:8787
ATOMS_CALLBACK_PATH=/atoms/callback
ATOMS_CALLBACK_TIMESTAMP_WINDOW=300

# `openssl rand -base64 32`. The Worker needs the same value, put there by the
# Configure Callback Channel workflow from the secret of the same name.
# Not a bearer token — never send it. `atoms token` prints the one to send.
ATOMS_SHARED_SECRET=

# The old secret, during a rotation. See docs/deployment.md.
# ATOMS_SHARED_SECRET_PREVIOUS=

QUEUE_CONNECTION=sync

MANCALA_GAME_LIFETIME_HOURS=24
MANCALA_DISCOVERY_LIMIT=5
MANCALA_DISCOVERY_CANDIDATES=20
MANCALA_LOBBY_REFRESH_MS=15000
MANCALA_STONE_DROP_MS=220
MANCALA_RECONNECT_MS=1200
MANCALA_RECONNECT_MAX_MS=15000
MANCALA_TICKET_MINTS_PER_MINUTE=30
